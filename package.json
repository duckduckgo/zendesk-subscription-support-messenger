{
  "name": "ai-support-ticket-deflection",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:tls": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.3"
    },
    "sharp": "0.35.5",
    "postcss": "8.5.25",
    "nanoid": "^3.3.18",
    "@humanfs/node": "^0.16.8",
    "browserslist": "^4.28.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "3.7.4",
    "typescript": "^5"
  }
}
